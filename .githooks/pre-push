#!/bin/sh

# Ekip360 — pre-push. İki kural uygular. Kanca .githooks/ altında versiyonlanır;
# etkinleşmesi için core.hooksPath ayarı gerekir (package.json > prepare).
#
#   1) Korunan dallar origin'e push edilmez.
#   2) Oturum linki (Claude-Session) taşıyan hiçbir commit push edilmez.
#
# Kural kaynağı: AGENTS.md > "Push Politikası ve Korunan Branch'ler"

remote="$1"
url="$2"

# ---------------------------------------------------------------------------
# KURAL 1 — korunan dallar
# Neden: docs/playbook-migration-framework, 01.09.2026'da Copilot tarafından
# yanlışlıkla push edilmek istendi.
# KARA LİSTE: AGENTS.md ile senkron tut.
blocklist="
docs/playbook-migration-framework
"

# ---------------------------------------------------------------------------
# KURAL 2 — oturum linki
# Neden: Ekip360 PUBLIC. "Claude-Session:" satırı, commit ile ilgisiz her şeyi
# içeren bir oturum kaydına işaret eder. 2026-09-08..10 arasında üç kez public
# depoya girdi, üç kez geçmiş yeniden yazılarak temizlendi.
# Bu, commit-msg kancasının ikinci katmanıdır: --no-verify ile atlatılan ya da
# cherry-pick/rebase yoluyla yeniden kullanılan mesajları burada yakalar.
SESSION_PATTERN='^[[:space:]]*Claude-Session:|claude\.ai/code/session_'

ZERO='0000000000000000000000000000000000000000'
fail=0

while read local_ref local_sha remote_ref remote_sha; do
  # dal silme işlemi — kontrol edilecek commit yok
  [ "$local_sha" = "$ZERO" ] && continue

  case "$local_ref" in
    refs/heads/*)
      branch=${local_ref#refs/heads/}

      # --- KURAL 1 ---
      for blocked in $blocklist; do
        if [ "$branch" = "$blocked" ]; then
          echo "~> [pre-push] '$branch' korunan bir daldır ve '$remote' uzak deposuna push edilemez."
          echo "   Kural: AGENTS.md > Push Politikasi ve Korunan Branch'ler."
          echo "   Paylasim gerekirse icerigi yeni bir dal adi ile tasiyin ve kural listelerini guncelleyin."
          exit 1
        fi
      done
      ;;
  esac

  # --- KURAL 2: gidecek commit'lerin mesajlarını tara ---
  if [ "$remote_sha" = "$ZERO" ]; then
    # yeni dal: uzakta hiç olmayan commit'ler
    range="$local_sha --not --remotes=origin"
  else
    range="$remote_sha..$local_sha"
  fi

  for sha in $(git rev-list $range 2>/dev/null); do
    if git log -1 --format=%B "$sha" | grep -qE "$SESSION_PATTERN"; then
      echo "~> [pre-push] $(git log -1 --format=%h "$sha") commit mesajı oturum linki taşıyor — push engellendi."
      echo "   $(git log -1 --format=%s "$sha")"
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "   Ekip360 PUBLIC bir depodur; oturum linki ilgisiz içeriğe işaret eder."
  echo "   Duzeltme: mesaji temizleyip yeniden yazin, ornegin"
  echo "     git rebase -i <taban>   ya da tek commit icin   git commit --amend"
  echo "   Kaynak: .githooks/pre-push (KURAL 2)"
  exit 1
fi

exit 0
